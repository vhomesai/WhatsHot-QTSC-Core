{
  "name": "whatshot-qtsc-core-evm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat compile --build-profile production",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "preflight:mainnet-readonly": "vite deployer --host 127.0.0.1 --port 3001",
