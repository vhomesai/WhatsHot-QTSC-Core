# Load these into the local shell. Hardhat does not auto-load this file.
# Never commit private keys, API keys, transaction hashes, or funded addresses.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=0x...
ETHERSCAN_API_KEY=...

# Three distinct Base Sepolia Safes. Each must use the production owner set and
# a 2-of-3 threshold.
QTSC_OWNER_SAFE=0x...
QTSC_ESCROW_SAFE=0x...
QTSC_OPERATIONS_SAFE=0x...
QTSC_PRODUCTION_SAFE_OWNERS=0x...,0x...,0x...

# A reviewed, project-controlled bytes32 value. Keep it unchanged across the
# rehearsal and production deployment process.
QTSC_DEPLOYMENT_SALT=0x...
QTSC_SEPOLIA_DEPLOY_CONFIRMATION=DEPLOY_QTSC_TO_BASE_SEPOLIA

# Generated/recorded files. rehearsal-output is gitignored.
QTSC_DEPLOYMENT_FILE=deployments/base-sepolia-rehearsal.json
QTSC_REHEARSAL_OUTPUT_DIR=rehearsal-output
QTSC_REHEARSAL_RESULTS=rehearsal-output/rehearsal-results.json
